{
  "enabled": true,
  "name": "Backend Tests on Save",
  "description": "Runs the backend pytest suite whenever a Python file under backend/app/ is saved, so the kernel and API stay green during development.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "backend/app/**/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "python -m pytest backend/tests -c backend/pyproject.toml --rootdir backend",
    "timeout": 300
  }
}