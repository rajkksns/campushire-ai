{
  "mcpServers": {
    "campushire-ai": {
      "command": "python",
      "args": ["-m", "mcp_server.server"],
      "cwd": "backend",
      "disabled": false,
      "autoApprove": [
        "list_known_skills",
        "normalize_skill",
        "resolve_skill_alias",
        "preview_required_skills"
      ]
    },
    "skill-gap-report": {
      "command": "python",
      "args": ["../.kiro/powers/skill-gap-report/server/report_power.py"],
      "cwd": "backend",
      "disabled": false,
      "autoApprove": ["generate_skill_gap_report"]
    }
  }
}
